# Environment for crono-worker.service. The package installs this file once and
# keeps local changes on upgrade. It is readable only by root and the crono
# group. Leave CRONO_WORKER_ID unset to derive a fresh hostname-based ID for
# every process.

CRONO_NATS_URL=nats://127.0.0.1:4222
CRONO_WORKER_QUEUE=default
CRONO_WORKER_CONCURRENCY=8
#CRONO_WORKER_ID=
