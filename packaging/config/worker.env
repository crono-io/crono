# Environment for crono-worker.service. The package installs this file once and
# keeps local changes on upgrade. It is readable only by root and the crono
# group. Leave CRONO_WORKER_ID unset to derive a fresh hostname-based ID for
# every process.

CRONO_NATS_URL=nats://127.0.0.1:4222
CRONO_WORKER_QUEUE=default
CRONO_WORKER_CONCURRENCY=8
#CRONO_WORKER_ID=

# Remote NATS: a tls:// URL or a CA file forces TLS. Set at most one identity:
# an NKey seed file, a .creds file, or CRONO_NATS_USER with CRONO_NATS_PASSWORD.
# When NATS permissions are scoped per worker, set CRONO_WORKER_ID to the ID
# that identity is allowed to use. Secret files must be readable by the crono
# user and are re-read on every reconnect.
#CRONO_NATS_URL=tls://nats.example.internal:4222
#CRONO_NATS_TLS_CA_FILE=/etc/crono/nats/ca.crt
#CRONO_NATS_NKEY_SEED_FILE=/etc/crono/nats/nkey.seed
#CRONO_NATS_CREDS_FILE=
#CRONO_NATS_USER=
#CRONO_NATS_PASSWORD=
