# Environment for crono-server.service. The package installs this file once and
# keeps local changes on upgrade. It may hold database credentials, so it is
# readable only by root and the crono group. Every setting, including the
# CRONO_DATABASE_* pool and CRONO_OUTBOX_* publisher tuning, is described in
# the README.

CRONO_DATABASE_URL=postgres://crono_runtime@127.0.0.1:5432/crono
CRONO_NATS_URL=nats://127.0.0.1:4222
CRONO_SERVER_PORT=8080

# Remote PostgreSQL: verify the server certificate and host name, and keep the
# password out of the URL.
#CRONO_DATABASE_URL=postgres://crono_runtime@db.example.internal:5432/crono?sslmode=verify-full&sslrootcert=/etc/crono/postgres/ca.crt
#PGPASSWORD=

# Remote NATS: a tls:// URL or a CA file forces TLS. Set at most one identity:
# an NKey seed file, a .creds file, or CRONO_NATS_USER with CRONO_NATS_PASSWORD.
#CRONO_NATS_URL=tls://nats.example.internal:4222
#CRONO_NATS_TLS_CA_FILE=/etc/crono/nats/ca.crt
#CRONO_NATS_NKEY_SEED_FILE=/etc/crono/nats/nkey.seed
#CRONO_NATS_CREDS_FILE=
#CRONO_NATS_USER=
#CRONO_NATS_PASSWORD=
#CRONO_NATS_REPLICAS=3
